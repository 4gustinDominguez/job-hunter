# AI provider for CV extraction / matching / documents (Phase 6+)
# provider: ollama (local dev, default) | ollama-cloud (production) | groq | huggingface
#
# LOCAL DEV (default): ollama — the free cloud models (gemma4:31b-cloud) route
# through the local Ollama daemon (~2-5 s/call, best JSON reliability). The
# daemon path does NOT work on serverless (Vercel) — use ollama-cloud there.
# Local CPU models measured on this machine are opt-in only:
#   qwen2.5:3b — ~20-45 s per call, invalid JSON more often (retry → feels broken)
#   qwen2.5-coder:14b — >3 min on CPU, unusable
AI_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:31b-cloud
# OLLAMA_NUM_CTX=8192
#
# PRODUCTION (Vercel): ollama-cloud — Ollama's hosted API (ollama.com/api/chat),
# same gemma4 model as local, works without any local daemon. Free plan ($0)
# includes starter usage credits; our daily cron (~25 calls) costs cents/month.
# Create a free API key at https://ollama.com/settings/keys.
# NOTE: hosted API model name is the plain tag (gemma4:31b) — the "-cloud"
# suffix is only for the local CLI/daemon.
# AI_PROVIDER=ollama-cloud
# OLLAMA_API_KEY=...
# OLLAMA_CLOUD_MODEL=gemma4:31b
#
# Alternative: groq — genuinely free tier (no credits), OpenAI-compatible,
# ~1-5 s per call on gpt-oss models. Free limits: 30 req/min, ~1000 req/day.
# AI_PROVIDER=groq
# GROQ_API_KEY=gsk_...
# GROQ_MODEL=openai/gpt-oss-120b
#
# Alternative: huggingface (router.huggingface.co — monthly free credits, small)
# HF_TOKEN=hf_xxxxxxxx
# HF_MODEL=Qwen/Qwen2.5-7B-Instruct

# Job sources enabled for fetch (comma separated): fixture, remotive, arbeitnow, himalayas, wwr
# Default (unset): remotive,arbeitnow,himalayas,wwr — real sources only; fixture is opt-in mock data.
# NOTE: from /integrations on, this is only the INITIAL state — per-provider rows
# saved on the page win over this value.
# JOB_SOURCES=remotive,arbeitnow,himalayas,wwr

# Master key for API keys stored via /integrations (AES-256-GCM at rest in the
# DB). Lose it → stored keys become unreadable (re-enter them on the page).
# Generate: openssl rand -base64 32
# SETTINGS_SECRET=

# Cron secret for /api/cron/fetch-jobs (Phase 10 deploy; route returns 401 without it)
# CRON_SECRET=change-me

# Auth (Phase 10) — single-user login, required on every deployment
# Generate:  pnpm auth:hash "your-password"   → AUTH_PASSWORD_HASH
#            openssl rand -base64 32          → AUTH_SECRET
# AUTH_USERNAME=agustin
# AUTH_PASSWORD_HASH=salt:hash
# AUTH_SECRET=


# Batch size per analyze-jobs run (leftovers stay pending for the next run)
# ANALYZE_BATCH_SIZE=25
