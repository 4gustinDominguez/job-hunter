# AI provider for CV extraction / matching / documents (Phase 6+)
# provider: ollama (default) | huggingface
AI_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
# gemma4:31b-cloud (Ollama free cloud) is the RECOMMENDED default: ~2-5 s per call,
# best JSON reliability. The job postings + profile sent are public/personal data
# the user would send to employers anyway (user decision 2026-10-21).
# Local CPU models measured on this machine are opt-in only:
#   qwen2.5:3b — ~20-45 s per call, invalid JSON more often (retry → feels broken)
#   qwen2.5-coder:14b — >3 min on CPU, unusable
OLLAMA_MODEL=gemma4:31b-cloud
# HF_TOKEN=hf_xxxxxxxx
# HF_MODEL=Qwen/Qwen2.5-7B-Instruct

# Optional: Ollama context window (default 8192; its own default 4096 truncates long CVs)
# OLLAMA_NUM_CTX=8192

# Job sources enabled for fetch (comma separated): fixture, remotive, arbeitnow
# Default (unset): remotive,arbeitnow — real sources only; fixture is opt-in mock data.
# JOB_SOURCES=remotive,arbeitnow

# Cron secret for /api/cron/fetch-jobs (Phase 10 deploy; route returns 401 without it)
# CRON_SECRET=change-me

# Auth (Phase 10) — single-user login, required on every deployment
# Generate:  pnpm auth:hash "your-password"   → AUTH_PASSWORD_HASH
#            openssl rand -base64 32          → AUTH_SECRET
# AUTH_USERNAME=agustin
# AUTH_PASSWORD_HASH=salt:hash
# AUTH_SECRET=


# Batch size per analyze-jobs run (leftovers stay pending for the next run)
# ANALYZE_BATCH_SIZE=25
